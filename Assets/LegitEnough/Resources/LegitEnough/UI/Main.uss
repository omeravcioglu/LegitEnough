/* =====================================================================
   LEGIT ENOUGH - pixel look (from the visual-direction canvas).
   Fonts: Legit Pixel (body, 5x7) and Legit Stamp (bold capitals), both
   generated by Tools/ArtGen/fonts.js. Sizes in multiples of 12 keep the
   font pixels even (24 = 2x, 36 = 3x, 48 = 4x).
   Shapes are square with bevelled borders: light top/left, dark bottom/right.
   Code only assigns these class names and positions.
   ===================================================================== */

:root {
    --le-bg: #0b0907;
    --le-panel: #1b1612;
    --le-panel-2: #241d17;
    --le-panel-hi: #4a3e30;
    --le-panel-lo: #0e0b09;
    --le-paper: #e6dcc4;
    --le-paper-2: #d8ccb0;
    --le-paper-line: #c9bda2;
    --le-ink: #2a241c;
    --le-ink-soft: #5a5146;
    --le-pen: #23407a;
    --le-text: #e9e0c8;
    --le-muted: #b3a990;
    --le-accent: #e0a83a;
    --le-red: #c0392b;
    --le-good: #7fae5a;
    --le-bad: #e0645e;
    --le-os-face: #cbc4ad;
    --le-os-hi: #efe8d2;
    --le-os-lo: #4e4839;
    --le-os-ink: #221d16;
    --le-os-title: #4b3f6e;
}

.le-root {
    background-color: var(--le-bg);
    -unity-font-definition: resource("LegitEnough/Fonts/LegitPixel");
    font-size: 24px;
    color: var(--le-text);
}

.le-stage {
    overflow: hidden;
    background-color: #000000;
}

Label {
    white-space: normal;
}

/* ---------------------------------------------------------------- generic */

.le-row { flex-direction: row; align-items: center; }
.le-row--wrap { flex-wrap: wrap; }
.le-row--end { justify-content: flex-end; }
.le-row--center { justify-content: center; }
.le-col { flex-direction: column; flex-grow: 1; }

.le-h1 { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); font-size: 48px; color: var(--le-text); margin-bottom: 12px; }
.le-h2 { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); font-size: 36px; color: var(--le-text); margin-bottom: 8px; }
.le-text { font-size: 24px; color: var(--le-text); margin-bottom: 8px; }
.le-muted { font-size: 24px; color: var(--le-muted); }

.le-clickable { transition-duration: 0.08s; transition-property: translate, opacity, border-color, background-color; }
.le-clickable:hover { translate: 0 -4px; }

/* Invisible click targets over things drawn in the pixel art. */
.le-hit { background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgba(0, 0, 0, 0); }
.le-hit:hover { border-color: rgba(224, 168, 58, 0.55); }
.le-px-layer { position: absolute; }
.le-px-sprite { transition-duration: 0.08s; transition-property: translate, opacity; }
.le-px-sprite:hover { translate: 0 -4px; }
.le-flicker { background-color: #000000; }

/* Buttons: square, bevelled, stamped capitals. */
.le-btn {
    margin: 6px;
    padding: 8px 18px 10px 18px;
    -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp");
    font-size: 24px;
    -unity-font-style: normal;
    color: var(--le-text);
    background-color: #2e251d;
    border-width: 4px;
    border-top-color: #5a4a3a;
    border-left-color: #5a4a3a;
    border-bottom-color: #120e0b;
    border-right-color: #120e0b;
    border-radius: 0;
    transition-duration: 0.06s;
    transition-property: background-color, border-color, translate;
}
.le-btn:hover { background-color: #3d3126; border-top-color: var(--le-accent); border-left-color: var(--le-accent); }
.le-btn:active { translate: 0 4px; border-top-color: #120e0b; border-left-color: #120e0b; border-bottom-color: #5a4a3a; border-right-color: #5a4a3a; }
.le-btn:disabled { opacity: 0.35; }
.le-btn--primary { background-color: #b8782a; color: #1c1206; border-top-color: #f0b858; border-left-color: #f0b858; border-bottom-color: #5a3810; border-right-color: #5a3810; }
.le-btn--primary:hover { background-color: #d08a32; border-top-color: #ffd890; border-left-color: #ffd890; }
.le-btn--danger { background-color: #7a2620; color: #ffe8e0; border-top-color: #b8463a; border-left-color: #b8463a; border-bottom-color: #3a100c; border-right-color: #3a100c; }
.le-btn--danger:hover { background-color: #8e2e26; }
.le-btn--ghost { background-color: rgba(0, 0, 0, 0); border-width: 3px; border-color: #5a4a3a; }
.le-btn--ghost:hover { background-color: rgba(224, 168, 58, 0.12); border-color: var(--le-accent); }
.le-btn--small { font-size: 24px; padding: 4px 12px 6px 12px; margin: 4px; }
.le-btn--icon { min-width: 48px; }
.le-btn--big { font-size: 36px; padding: 12px 30px 14px 30px; min-width: 220px; }
.le-btn--selected { border-color: var(--le-accent); background-color: #4a3a22; }
.le-btn--swatch { color: #1a1612; min-width: 150px; border-top-color: rgba(255, 255, 255, 0.45); border-left-color: rgba(255, 255, 255, 0.45); border-bottom-color: rgba(0, 0, 0, 0.5); border-right-color: rgba(0, 0, 0, 0.5); }
.le-btn--swatch.le-btn--selected { border-color: var(--le-accent); border-width: 6px; }
.le-btn--say {
    -unity-font-definition: resource("LegitEnough/Fonts/LegitPixel");
    font-size: 24px;
    padding: 6px 12px 8px 12px;
    background-color: #263329;
    border-top-color: #4f6455;
    border-left-color: #4f6455;
    border-bottom-color: #0e1610;
    border-right-color: #0e1610;
}
.le-btn--say:hover { background-color: #33453a; }
.le-btn--choice {
    -unity-font-definition: resource("LegitEnough/Fonts/LegitPixel");
    font-size: 24px;
    -unity-text-align: middle-left;
    white-space: normal;
    padding: 10px 16px 12px 16px;
    background-color: var(--le-paper);
    color: var(--le-ink);
    border-width: 3px;
    border-top-color: #f4ecd8;
    border-left-color: #f4ecd8;
    border-bottom-color: #8a7e64;
    border-right-color: #8a7e64;
}
.le-btn--choice:hover { background-color: #fff3d6; border-top-color: var(--le-accent); border-left-color: var(--le-accent); }
.le-btn--menu {
    font-size: 36px;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 8px 12px 8px 44px;
    margin: 2px 0;
    color: var(--le-text);
}
.le-btn--menu:hover { background-color: #2a2219; color: #f0c86a; }
.le-btn--menu:active { translate: 0 0; }

.le-card {
    background-color: var(--le-panel);
    border-width: 4px;
    border-top-color: var(--le-panel-hi);
    border-left-color: var(--le-panel-hi);
    border-bottom-color: var(--le-panel-lo);
    border-right-color: var(--le-panel-lo);
    border-radius: 0;
    padding: 30px;
}

/* ---------------------------------------------------------------- overlays */

.le-overlay { position: absolute; }
.le-overlay--dim { background-color: rgba(8, 6, 5, 0.72); }
.le-overlay--dark { background-color: rgba(8, 6, 5, 0.97); }
.le-overlay--black { background-color: rgb(6, 5, 4); }
.le-overlay--camera { background-color: rgb(14, 12, 11); }
.le-overlay--title { background-color: rgba(6, 5, 4, 0.2); }

.le-confirm .le-text { margin-top: 10px; margin-bottom: 30px; }
.le-pause { align-items: stretch; }
.le-pause > .le-btn { margin: 6px 40px; }
.le-pause > .le-h1 { -unity-text-align: middle-center; }
.le-pause > .le-muted { -unity-text-align: middle-center; margin-top: 8px; font-size: 24px; }
.le-pause__mark { align-self: center; margin-bottom: 8px; }
.le-printmenu > .le-datapage { margin: 16px 0; align-self: center; }

.le-toasts {
    position: absolute;
    right: 16px;
    top: 16px;
    width: 560px;
    flex-direction: column;
    align-items: flex-end;
}
.le-toast {
    background-color: rgba(27, 22, 18, 0.95);
    border-width: 4px;
    border-top-color: var(--le-panel-hi);
    border-right-color: var(--le-panel-lo);
    border-bottom-color: var(--le-panel-lo);
    border-left-width: 12px;
    border-left-color: var(--le-accent);
    color: var(--le-text);
    font-size: 24px;
    padding: 8px 16px 10px 16px;
    margin-top: 6px;
}
.le-toast--good { border-left-color: var(--le-good); }
.le-toast--bad { border-left-color: var(--le-bad); }

/* ---------------------------------------------------------------- title */

.le-title {
    background-color: rgba(11, 9, 7, 0.86);
    border-width: 4px;
    border-top-color: var(--le-panel-hi);
    border-left-color: var(--le-panel-hi);
    border-bottom-color: var(--le-panel-lo);
    border-right-color: var(--le-panel-lo);
    padding: 20px 28px 26px 28px;
}
.le-title__logo { align-self: center; margin-bottom: 12px; }
.le-title__menu { margin: 8px 0 14px 0; }
.le-title__foot { font-size: 24px; color: var(--le-muted); border-top-width: 3px; border-color: #3a3229; padding-top: 10px; flex-direction: row; justify-content: space-between; }
.le-credits { -unity-text-align: middle-left; }

/* ---------------------------------------------------------------- shop floating UI */

.le-hint {
    max-width: 1060px;
    background-color: #e2cd48;
    color: #2a2418;
    font-size: 24px;
    padding: 6px 14px 8px 14px;
    border-bottom-width: 4px;
    border-right-width: 4px;
    border-color: #a8942a;
    -unity-text-align: middle-left;
}

.le-bubble {
    background-color: #f4ecd8;
    border-width: 4px;
    border-color: #1a1410;
    border-radius: 0;
    padding: 10px 16px 12px 16px;
}
.le-bubble__name { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-red); font-size: 24px; margin-bottom: 2px; }
.le-bubble__text { color: var(--le-ink); font-size: 24px; }
.le-bubble__tail {
    position: absolute;
    left: 24px;
    bottom: -20px;
    width: 20px;
    height: 20px;
    background-color: #f4ecd8;
    border-left-width: 4px;
    border-bottom-width: 4px;
    border-color: #1a1410;
}
.le-bubble--left .le-bubble__tail { left: auto; right: 24px; border-left-width: 0; border-right-width: 4px; }
.le-bubble--camera { background-color: #f4ecd8; }

.le-choices {
    background-color: rgba(27, 22, 18, 0.94);
    border-width: 4px;
    border-top-color: var(--le-panel-hi);
    border-left-color: var(--le-panel-hi);
    border-bottom-color: var(--le-panel-lo);
    border-right-color: var(--le-panel-lo);
    padding: 12px;
}
.le-choices__label { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-muted); font-size: 24px; margin-left: 6px; margin-bottom: 4px; }

/* ---------------------------------------------------------------- paper: client sheet */

.le-slip {
    background-color: var(--le-paper);
    padding: 36px 48px;
    border-bottom-width: 8px;
    border-right-width: 8px;
    border-color: #1a1410;
}
.le-slip__title { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-ink); font-size: 48px; }
.le-slip__order { color: var(--le-red); font-size: 24px; margin-bottom: 20px; }
.le-slip__lines { margin-bottom: 24px; }
.le-slip__row { flex-direction: row; align-items: center; margin-bottom: 10px; border-bottom-width: 2px; border-color: var(--le-paper-line); }
.le-slip__label { color: var(--le-ink-soft); font-size: 24px; width: 220px; }
.le-slip__hand { color: var(--le-pen); font-size: 36px; flex-grow: 1; }
.le-slip__aside { color: var(--le-ink-soft); font-size: 24px; margin-top: 8px; }
.le-slip__job { background-color: var(--le-paper-2); padding: 16px; margin-bottom: 16px; border-left-width: 6px; border-color: var(--le-red); }
.le-slip__jobtitle { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-ink); font-size: 36px; }
.le-slip__jobline { color: var(--le-ink); font-size: 24px; margin-top: 4px; }
.le-slip__buttons { justify-content: flex-end; }
.le-slip__buttons .le-btn--ghost { color: var(--le-ink); border-color: #8a7e64; }

.le-pinned { }
.le-slip--pinned { padding: 18px 18px; }
.le-slip--pinned .le-slip__title { font-size: 24px; }
.le-slip--pinned .le-slip__label { width: 100%; font-size: 24px; }
.le-slip--pinned .le-slip__row { flex-direction: column; align-items: flex-start; }
.le-slip--pinned .le-slip__hand { font-size: 24px; }
.le-slip--pinned .le-slip__jobtitle { font-size: 24px; }
.le-slip--pinned .le-slip__jobline { font-size: 24px; }
.le-tape { position: absolute; top: -12px; left: 110px; width: 92px; height: 28px; background-color: rgba(232, 222, 176, 0.78); }

/* ---------------------------------------------------------------- data page */

.le-datapage {
    width: 520px;
    height: 360px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0.3);
    padding: 12px 16px;
    overflow: hidden;
}
.le-datapage--large { width: 760px; height: 530px; }
.le-datapage--large .le-datapage__photo { width: 230px; height: 296px; }
.le-datapage--book .le-datapage__photo { width: 270px; height: 347px; }
.le-datapage--book { width: 860px; height: 600px; }
.le-datapage__pattern { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.le-datapage__head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; flex-wrap: wrap; }
.le-datapage__header { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #2b3550; font-size: 24px; }
.le-datapage__sub { color: #4d5670; font-size: 24px; }
.le-datapage__category { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #7a2a2a; font-size: 24px; border-width: 3px; border-color: #7a2a2a; padding: 0 8px 2px 8px; }
.le-datapage__body { flex-direction: row; flex-grow: 1; }
.le-datapage__photo {
    width: 150px;
    height: 193px;
    background-color: rgba(0, 0, 0, 0.08);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.35);
    margin-right: 16px;
    justify-content: center;
}
.le-datapage__portrait { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.le-datapage__nophoto { color: rgba(0, 0, 0, 0.4); font-size: 24px; -unity-text-align: middle-center; }
.le-datapage__fields { flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.le-datapage__field { width: 50%; margin-bottom: 4px; }
.le-datapage__label, .le-datapage__value { margin: 0; padding: 0; }
.le-datapage__label { color: #5c6478; font-size: 12px; }
.le-datapage__value { color: #15182a; font-size: 24px; }
.le-datapage--large .le-datapage__value { font-size: 24px; }
.le-datapage--large .le-datapage__label { font-size: 12px; }
.le-datapage--book .le-datapage__value { font-size: 36px; }
.le-datapage--book .le-datapage__label { font-size: 24px; }
.le-datapage--book .le-datapage__header { font-size: 36px; }
.le-datapage__code { height: 26px; margin-top: 4px; }
.le-datapage__smudge {
    position: absolute;
    left: 30%;
    top: 40%;
    width: 60%;
    height: 24px;
    background-color: rgba(10, 10, 20, 0.7);
    rotate: -12deg;
}

/* ---------------------------------------------------------------- passport booklet */

.le-passport { flex-direction: row; justify-content: center; align-items: center; }
.le-passport__cover {
    width: 430px;
    height: 600px;
    align-items: center;
    justify-content: center;
    border-width: 4px;
    border-right-width: 10px;
    border-color: rgba(0, 0, 0, 0.45);
}
.le-passport__cover-title { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #e8cf7e; font-size: 36px; -unity-text-align: middle-center; }
.le-passport__emblem { margin: 24px 0; }
.le-passport__pages { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #e8cf7e; font-size: 24px; margin-top: 30px; }
.le-passport__meta { color: rgba(232, 207, 126, 0.75); font-size: 24px; margin-top: 6px; }
.le-passport__who { color: var(--le-muted); font-size: 24px; -unity-text-align: middle-center; }

/* ---------------------------------------------------------------- handbook binder */

.le-binder {
    flex-direction: row;
    background-color: #2c4232;
    border-width: 6px;
    border-top-color: #3d5a48;
    border-left-color: #3d5a48;
    border-bottom-color: #16241a;
    border-right-color: #16241a;
    padding: 18px;
}
.le-binder__page {
    flex-grow: 1;
    flex-basis: 0;
    background-color: #ece4cc;
    padding: 34px 40px;
    border-bottom-width: 4px;
    border-right-width: 4px;
    border-color: #a89c7c;
}
.le-binder__page--left { margin-right: 4px; }
.le-binder__page--right { margin-left: 4px; }
.le-binder__rings { width: 36px; background-color: #1f3226; margin: 0; justify-content: space-around; align-items: center; }
.le-binder__ring { width: 28px; height: 28px; border-width: 5px; border-color: #a8aaa6; border-left-color: #6a6c68; border-radius: 14px; }
.le-binder__tabs { flex-direction: column; }
.le-binder__hint { color: var(--le-muted); font-size: 24px; }
.le-tab {
    flex-direction: row;
    align-items: center;
    background-color: #d8cfb2;
    padding: 8px 12px 10px 10px;
    margin-bottom: 6px;
    border-width: 3px;
    border-left-width: 0;
    border-color: #6a5f4c;
}
.le-tab__flag { margin-right: 8px; }
.le-tab__text { flex-direction: column; flex-shrink: 1; }
.le-tab--active { background-color: #f4ecd8; border-color: var(--le-red); translate: -8px 0; }
.le-tab--locked { background-color: #6b6458; border-color: #4a4438; }
.le-tab__label { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #2a2420; font-size: 24px; }
.le-tab--locked .le-tab__label { color: #d4cbb8; }
.le-tab__state { color: var(--le-red); font-size: 12px; }
.le-tab--locked .le-tab__state { color: #f0d080; }

.le-hb__title { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #1d1a16; font-size: 36px; margin-bottom: 16px; border-bottom-width: 4px; border-color: #1d1a16; padding-bottom: 4px; }
.le-hb__row { flex-direction: row; margin-bottom: 6px; border-bottom-width: 2px; border-color: #c9d2d6; padding-bottom: 4px; }
.le-hb__label { color: #6a5f50; font-size: 24px; width: 230px; }
.le-hb__value { color: #1d1a16; font-size: 24px; flex-grow: 1; flex-shrink: 1; }
.le-hb__value--wide { font-size: 24px; color: #4a4238; }
.le-hb__note { color: var(--le-pen); font-size: 24px; margin: 6px 0 6px 10px; }
.le-coverage-diagram { height: 210px; margin: 10px 0 18px 0; }
.le-sticky {
    background-color: #e2cd48;
    padding: 14px;
    margin-top: 24px;
    border-bottom-width: 4px;
    border-right-width: 4px;
    border-color: #9a8a2a;
}
.le-sticky--alert { background-color: #f0a090; border-color: #9a4a3a; }
.le-sticky__text { color: #2a2420; font-size: 24px; }

/* ---------------------------------------------------------------- camera */

.le-viewfinder {
    background-color: #050505;
    border-width: 4px;
    border-top-color: #3a3a3a;
    border-left-color: #3a3a3a;
    border-bottom-color: #000000;
    border-right-color: #000000;
}
.le-viewfinder__image { }
.le-flash { background-color: #ffffff; }
.le-vf-label { position: absolute; -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #ffffff; font-size: 24px; background-color: rgba(0, 0, 0, 0.55); padding: 2px 10px 4px 10px; }
.le-vf-label--tl { left: 30px; top: 28px; }
.le-vf-label--bl { left: 30px; bottom: 28px; }
.le-camera__table { color: var(--le-accent); font-size: 24px; }

.le-cam-panel { padding: 10px 20px; }
.le-cam-panel__job { color: var(--le-accent); font-size: 24px; margin-bottom: 4px; }
.le-cam-panel__section { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-muted); font-size: 24px; margin-top: 16px; margin-bottom: 4px; }
.le-cam-panel__help { color: var(--le-muted); font-size: 24px; margin: 4px 6px; }
.le-cam-panel__shutter-row { margin-top: 14px; }
.le-cam-panel__kept { min-height: 140px; }
.le-cam-panel__bottom { margin-top: 14px; }
.le-shutter {
    width: 168px;
    height: 168px;
    border-radius: 84px;
    background-color: #9a2b2b;
    border-width: 10px;
    border-color: #3a1414;
    -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp");
    font-size: 24px;
    color: #fff0e0;
    margin: 6px 20px;
}
.le-shutter:hover { background-color: #b33434; }
.le-shutter:active { translate: 0 4px; }

.le-thumb { width: 98px; height: 126px; margin: 6px; border-width: 3px; border-color: #555555; }
.le-portrait { }

/* ---------------------------------------------------------------- review & crop */

.le-review__frame { border-width: 4px; border-color: #e8e2d2; background-color: #000000; }
.le-review__side { }
.le-review__side > .le-cam-panel__section { margin-top: 0; }
.le-review__preview { border-width: 4px; border-color: #e8e2d2; }
.le-crop__area { border-width: 4px; border-color: #e8e2d2; }
.le-crop__rect { border-width: 4px; border-color: var(--le-accent); }
.le-crop__handle {
    position: absolute;
    width: 24px;
    height: 24px;
    background-color: var(--le-accent);
    border-width: 3px;
    border-color: #3a2a10;
}
.le-crop__handle--tl { left: -14px; top: -14px; }
.le-crop__handle--tr { right: -14px; top: -14px; }
.le-crop__handle--bl { left: -14px; bottom: -14px; }
.le-crop__handle--br { right: -14px; bottom: -14px; }
.le-crop__ruler { }
.le-crop__ruler-label { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-accent); font-size: 24px; }

/* ---------------------------------------------------------------- computer (late-90s OS) */

.le-monitor {
    background-color: #b3a888;
    border-width: 6px;
    border-top-color: #d0c6a6;
    border-left-color: #d0c6a6;
    border-bottom-color: #7d7560;
    border-right-color: #7d7560;
    border-radius: 18px;
    padding: 34px 40px 64px 40px;
}
.le-monitor--t2 { background-color: #1e1e22; border-top-color: #3a3a40; border-left-color: #3a3a40; border-bottom-color: #0a0a0c; border-right-color: #0a0a0c; border-radius: 6px; padding: 18px 18px 40px 18px; }
.le-monitor--t3 { background-color: #18181b; border-top-color: #34343a; border-left-color: #34343a; border-bottom-color: #08080a; border-right-color: #08080a; border-radius: 4px; padding: 12px 12px 34px 12px; }
.le-monitor__screen {
    flex-grow: 1;
    background-color: #1d4a4a;
    overflow: hidden;
    border-width: 4px;
    border-color: #111111;
}
.le-monitor--t2 .le-monitor__screen, .le-monitor--t3 .le-monitor__screen { background-color: #20354a; }
.le-monitor__brand { position: absolute; bottom: 18px; left: 60px; -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #7a735f; font-size: 24px; }
.le-monitor--t2 .le-monitor__brand, .le-monitor--t3 .le-monitor__brand { color: #6a6a72; bottom: 6px; left: 24px; }
.le-monitor__scanlines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.le-os-bar {
    flex-direction: row;
    align-items: center;
    height: 48px;
    background-color: var(--le-os-title);
    padding: 0 8px 0 12px;
}
.le-os-bar__title { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #f1ead6; font-size: 24px; flex-grow: 1; }
.le-os-bar__item { color: #f1ead6; font-size: 24px; margin-left: 24px; }
.le-os-close {
    -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp");
    background-color: var(--le-os-face);
    color: var(--le-os-ink);
    border-width: 3px;
    border-top-color: var(--le-os-hi);
    border-left-color: var(--le-os-hi);
    border-bottom-color: var(--le-os-lo);
    border-right-color: var(--le-os-lo);
    margin-left: 18px;
    padding: 0 12px 2px 12px;
    font-size: 24px;
}

.le-os-body { flex-direction: row; flex-grow: 1; }
.le-os-nav { width: 196px; background-color: rgba(0, 0, 0, 0); padding: 10px 4px; }
.le-os-nav__item {
    flex-direction: column;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #f1ead6;
    -unity-font-definition: resource("LegitEnough/Fonts/LegitPixel");
    font-size: 24px;
    padding: 6px 4px;
    margin: 2px 6px;
}
.le-os-nav__item:hover { background-color: rgba(255, 255, 255, 0.1); }
.le-os-nav__item:active { translate: 0 0; }
.le-os-nav__icon { margin-bottom: 2px; }
.le-os-nav__label { color: #f1ead6; font-size: 24px; -unity-text-align: middle-center; padding: 0 6px 2px 6px; }
.le-os-nav__item--active .le-os-nav__label { background-color: var(--le-os-title); }

.le-os-main {
    flex-grow: 1;
    margin: 10px 12px 12px 4px;
    padding: 14px 20px;
    background-color: var(--le-os-face);
    border-width: 4px;
    border-top-color: var(--le-os-hi);
    border-left-color: var(--le-os-hi);
    border-bottom-color: var(--le-os-lo);
    border-right-color: var(--le-os-lo);
    color: var(--le-os-ink);
}

.le-os-h1 { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-os-ink); font-size: 36px; margin-bottom: 10px; }
.le-os-h2 { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-os-title); font-size: 24px; margin-top: 12px; margin-bottom: 6px; }
.le-os-text { color: var(--le-os-ink); font-size: 24px; margin-bottom: 4px; }
.le-os-strong { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); }
.le-os-muted { color: #5a5446; font-size: 24px; margin-bottom: 4px; }
.le-os-bad { color: #a5352a; }
.le-os-good { color: #3a6a2a; }
.le-os-label { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #5a5446; font-size: 24px; min-width: 120px; margin-right: 6px; }

.le-os-row { flex-direction: row; padding: 6px 6px; border-bottom-width: 2px; border-color: #a8a08a; }
.le-os-row--head { border-color: var(--le-os-lo); }
.le-os-row--head .le-os-cell { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #5a5446; font-size: 24px; }
.le-os-row.le-clickable:hover { background-color: #ddd5bd; translate: 0 0; }
.le-os-cell { color: var(--le-os-ink); font-size: 24px; flex-grow: 1; flex-basis: 0; }
.le-os-chip {
    -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp");
    font-size: 24px;
    flex-grow: 0;
    align-self: flex-start;
    padding: 0 8px 2px 8px;
    border-width: 2px;
}
.le-os-chip--photo { background-color: #c4d2dc; color: #1c3448; border-color: #4a6a88; }
.le-os-chip--make { background-color: #d7c9a0; color: #4a3c14; border-color: #8a7a44; }
.le-os-chip--ready { background-color: #c9d6c0; color: #26401c; border-color: #5a7a48; }
.le-os-chip--other { background-color: #d8d2c4; color: #3a342a; border-color: #7a7262; }

.le-os-cols { flex-direction: row; flex-grow: 1; }
.le-os-list { width: 380px; border-right-width: 3px; border-color: #a8a08a; margin-right: 16px; }
.le-os-list--wide { width: 560px; }
.le-os-list--news { width: 470px; }
.le-os-reader { flex-grow: 1; }
.le-os-msg { padding: 8px 10px; border-bottom-width: 2px; border-color: #a8a08a; }
.le-os-msg.le-clickable:hover { background-color: #ddd5bd; translate: 0 0; }
.le-os-msg--selected { background-color: #efe8d2; }
.le-os-msg--unread .le-os-msg__from { color: #000000; -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); }
.le-os-msg__from { color: var(--le-os-ink); font-size: 24px; }
.le-os-msg__subject { color: #5a5446; font-size: 24px; }
.le-os-msg__time { color: #7a7262; font-size: 12px; }
.le-os-body-text {
    color: var(--le-os-ink);
    font-size: 24px;
    margin: 12px 0;
    padding: 12px 14px;
    background-color: #f6f1e2;
    border-width: 3px;
    border-top-color: var(--le-os-lo);
    border-left-color: var(--le-os-lo);
    border-bottom-color: var(--le-os-hi);
    border-right-color: var(--le-os-hi);
}

.le-os-btn {
    -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp");
    background-color: var(--le-os-face);
    border-width: 3px;
    border-top-color: var(--le-os-hi);
    border-left-color: var(--le-os-hi);
    border-bottom-color: var(--le-os-lo);
    border-right-color: var(--le-os-lo);
    color: var(--le-os-ink);
    font-size: 24px;
    padding: 2px 12px 4px 12px;
    margin: 3px;
    border-radius: 0;
}
.le-os-btn:hover { background-color: #d8d0b8; }
.le-os-btn:active { translate: 0 0; border-top-color: var(--le-os-lo); border-left-color: var(--le-os-lo); border-bottom-color: var(--le-os-hi); border-right-color: var(--le-os-hi); }
.le-os-btn--selected { background-color: #bdb59c; color: var(--le-os-title); border-top-color: var(--le-os-lo); border-left-color: var(--le-os-lo); border-bottom-color: var(--le-os-hi); border-right-color: var(--le-os-hi); }
.le-os-btn--small { font-size: 24px; padding: 0 10px 2px 10px; }
.le-os-btn--cover { border-left-width: 14px; }
.le-os-btn--primary { background-color: #2f5a4a; border-top-color: #5a8a74; border-left-color: #5a8a74; border-bottom-color: #12281f; border-right-color: #12281f; color: #f1ead6; font-size: 24px; padding: 8px 22px 10px 22px; }
.le-os-btn--primary:hover { background-color: #3a6a58; }
.le-os-btn--off { background-color: #c8a49c; color: #4a1a14; }
.le-os-btn--tab { font-size: 24px; }
.le-os-picker { margin-bottom: 8px; }
.le-os-form { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 320px; margin-right: 16px; }
.le-os-form--full { margin-right: 0; }
.le-os-preview { width: 470px; flex-shrink: 0; }
.le-os-preview > .le-datapage { width: 466px; height: 330px; }
.le-os-preview .le-datapage__photo { width: 128px; height: 165px; margin-right: 12px; }
.le-os-preview .le-datapage__value { font-size: 24px; }
.le-os-preview .le-datapage__header { font-size: 24px; }
.le-os-preview > .le-datapage { margin: 8px 0; }

.le-os-input { margin: 4px 0; flex-grow: 1; }
.le-os-input > Label { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: #5a5446; font-size: 24px; min-width: 190px; }
.le-os-input .unity-base-text-field__input {
    -unity-font-definition: resource("LegitEnough/Fonts/LegitPixel");
    background-color: #f6f1e2;
    border-width: 3px;
    border-top-color: var(--le-os-lo);
    border-left-color: var(--le-os-lo);
    border-bottom-color: var(--le-os-hi);
    border-right-color: var(--le-os-hi);
    border-radius: 0;
    color: var(--le-os-ink);
    font-size: 24px;
    padding: 2px 8px;
    --unity-cursor-color: #2f5a4a;
    --unity-selection-color: rgba(47, 90, 74, 0.3);
}
.le-os-input:focus .unity-base-text-field__input { border-top-color: var(--le-os-title); border-left-color: var(--le-os-title); }

.le-os-photo { border-width: 4px; border-color: rgba(0, 0, 0, 0); margin: 4px; }
.le-os-photo--selected { border-color: var(--le-os-title); }
.le-os-face { width: 160px; height: 206px; margin-right: 16px; border-width: 3px; border-color: var(--le-os-lo); }
.le-os-news { padding: 10px 6px; border-bottom-width: 2px; border-color: #a8a08a; }
.le-os-news__headline { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-os-ink); font-size: 24px; }
.le-os-shoprow { flex-direction: row; align-items: center; padding: 10px 6px; border-bottom-width: 2px; border-color: #a8a08a; }
.le-os-shoppics { flex-direction: row; align-items: center; width: 476px; flex-shrink: 0; margin-right: 12px; }
.le-os-product { }
.le-os-product--owned { opacity: 0.55; }
.le-os-product__arrow { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); font-size: 36px; color: var(--le-os-title); margin: 0 6px; }

/* Scrollbars in the shop computer: flat, bevelled, square. */
.le-monitor .unity-scroller--horizontal { display: none; }
.le-monitor .unity-scroller--vertical { width: 20px; }
.le-monitor .unity-base-slider__tracker { background-color: #bdb59c; border-width: 0; border-radius: 0; }
.le-monitor .unity-base-slider__dragger { background-color: var(--le-os-face); border-width: 3px; border-radius: 0; border-top-color: var(--le-os-hi); border-left-color: var(--le-os-hi); border-bottom-color: var(--le-os-lo); border-right-color: var(--le-os-lo); }
.le-monitor .unity-scroller__low-button, .le-monitor .unity-scroller__high-button { background-color: var(--le-os-face); border-radius: 0; border-width: 2px; border-color: var(--le-os-lo); }

/* ---------------------------------------------------------------- day cards */

.le-daycard { align-items: center; }
.le-daycard__logo { margin-bottom: 18px; }
.le-daycard__day { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-text); font-size: 120px; }
.le-daycard__date { color: var(--le-muted); font-size: 36px; margin-bottom: 36px; }
.le-daycard__list { align-self: stretch; margin: 0 80px 30px 80px; }
.le-daycard__item { color: var(--le-text); font-size: 24px; margin-bottom: 10px; }
.le-daycard__item--news { color: #f0c86a; }
.le-daycard__note { color: #d4c7aa; font-size: 24px; margin: 0 80px 30px 80px; -unity-text-align: middle-center; }

.le-ledger {
    background-color: var(--le-paper);
    padding: 40px 64px;
    border-bottom-width: 8px;
    border-right-width: 8px;
    border-color: #1a1410;
}
.le-ledger__title { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-ink); font-size: 36px; margin-bottom: 24px; }
.le-ledger__row { flex-direction: row; justify-content: space-between; padding: 4px 0; border-bottom-width: 2px; border-color: var(--le-paper-line); }
.le-ledger__row--minor .le-ledger__label, .le-ledger__row--minor .le-ledger__value { color: var(--le-ink-soft); font-size: 24px; }
.le-ledger__row--good .le-ledger__value { color: #2f7a35; }
.le-ledger__row--bad .le-ledger__value { color: #a8342b; }
.le-ledger__label { color: var(--le-ink); font-size: 24px; }
.le-ledger__value { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); color: var(--le-ink); font-size: 24px; }
.le-ledger__rule { height: 4px; background-color: var(--le-ink); margin: 14px 0; }
.le-ledger__warn { color: #a8342b; font-size: 24px; margin-top: 14px; }
.le-ledger .le-btn { margin-top: 30px; }

/* ---------------------------------------------------------------- dev lineup (F9) */

/* 8 columns x 3 rows must fit the 1860 x 990 grid. */
.le-lineup__cell { width: 206px; margin: 4px 6px; }
.le-lineup__portrait { width: 200px; height: 257px; border-width: 2px; border-color: #555555; }
.le-lineup__name { -unity-font-definition: resource("LegitEnough/Fonts/LegitStamp"); font-size: 12px; color: var(--le-text); }
.le-lineup__meta { font-size: 12px; color: var(--le-muted); }
